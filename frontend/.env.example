# Base URL do backend, usada pelo API client (src/api/http.ts).
#
# Em desenvolvimento (`npm run dev`), deixe sem definir (ou comentada):
# o proxy configurado em vite.config.ts encaminha as chamadas da API
# (/tasks, /tipos-de-acordo, /motivos-de-nao-cumprimento, /usuarios,
# /health) para o backend local, que escuta por padrão na porta 3001
# (ver backend/.env.example > PORT).
#
# Defina esta variável apenas se o backend estiver em outro host/porta,
# ou ao rodar o frontend fora do servidor de dev do Vite (ex.: `npm run
# preview`), onde o proxy de dev não está disponível.
# VITE_API_BASE_URL=http://localhost:3001
