{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "description": "Daily Agreements - backend (Node.js + TypeScript + Express + Prisma/SQLite)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "cors": "^2.8.6",
    "express": "4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/supertest": "6.0.2",
    "fast-check": "3.22.0",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
